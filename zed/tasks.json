[
  {
    "label": "Go: Run Current Test Function",
    "command": "go",
    "args": [
      "test",
      "-v",
      "-run",
      "$ZED_SYMBOL"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "Go: Run Current File",
    "command": "go",
    "args": [
      "run",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "JavaScript / TypeScript: Run Current File",
