[
  {
    "context": "AcpThread > Editor && vim_mode == normal && !menu",
    "bindings": {
      "ctrl-u": "agent::ScrollOutputPageUp",
      "ctrl-d": "agent::ScrollOutputPageDown",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-s": "workspace::Save",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "s s": "pane::SplitDown",
      "s v": "pane::SplitRight",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-a": ["workspace::SendKeystrokes", "g g shift-v shift-g"],
      "shift-g": ["workspace::SendKeystrokes", "shift-g z z"],
      "+": "vim::Increment",
      "-": "vim::Decrement",
      "x": ["workspace::SendKeystrokes", "\" _ x"],
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f r": "file_finder::Toggle",
      "space f shift-r": "file_finder::Toggle",
      "space f l": "buffer_search::Deploy",
      "space f p": "projects::OpenRecent",
      "space f z": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space b b": "tab_switcher::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space c w": "project_panel::ToggleFocus",
      "ctrl-up": "project_panel::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "editor::Hover",
      "space x x": "diagnostics::Deploy",
      "space x q": "diagnostics::Deploy",
      "space x l": "diagnostics::Deploy",
      "space b d": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
      "space b o": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false,
        },
      ],
      "space b a": [
        "pane::CloseAllItems",
        {
          "close_pinned": false,
        },
      ],
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "space w m": "workspace::ToggleZoom",
      "space u z": "workspace::ToggleZoom",
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",
      "space g g": "git_panel::ToggleFocus",
      "space g b": "editor::BlameHover",
      "space f t": "terminal_panel::Toggle",
      "space f shift-t": "terminal_panel::Toggle",
      "ctrl-/": "terminal_panel::Toggle",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space :": "command_palette::Toggle",
      "space q q": "zed::Quit",
      "d": ["workspace::SendKeystrokes", "\" _ d"],
      "c": ["workspace::SendKeystrokes", "\" _ c"],
      "shift-d": ["workspace::SendKeystrokes", "\" _ shift-d"],
      "shift-c": ["workspace::SendKeystrokes", "\" _ shift-c"],
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": [
        "editor::GoToDiagnostic",
        {
          "severity": {
            "min": "error",
            "max": "error",
          },
        },
      ],
      "[ e": [
        "editor::GoToPreviousDiagnostic",
        {
          "severity": {
            "min": "error",
            "max": "error",
          },
        },
      ],
      "space o o": "task::Spawn",
      "space o w": "terminal_panel::Toggle",
      "space o t": "task::Spawn",
      "space o r": [
        "task::Rerun",
        {
          "reevaluate_context": false,
        },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "d": ["workspace::SendKeystrokes", "\" _ d"],
      "c": ["workspace::SendKeystrokes", "\" _ c"],
      "shift-d": ["workspace::SendKeystrokes", "\" _ shift-d"],
      "shift-c": ["workspace::SendKeystrokes", "\" _ shift-c"],
      "space c f": "editor::Format",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-w": ["editor::DeleteToPreviousWordStart", { "ignore_newlines": false, "ignore_brackets": false }],
      "ctrl-a": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && vim_mode == insert && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Editor && vim_mode == insert && in_snippet && has_next_tabstop",
    "bindings": {
      "ctrl-l": "editor::NextSnippetTabstop",
    },
  },
  {
    "context": "Editor && vim_mode == insert && in_snippet && has_previous_tabstop",
    "bindings": {
      "ctrl-h": "editor::PreviousSnippetTabstop",
    },
  },
  {
    "context": "Dock && !Terminal && !Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "EmptyPane",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space f p": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space g g": "git_panel::ToggleFocus",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !menu && !VimCount",
    "bindings": {
      "j": [
        "vim::Down",
        {
          "display_lines": true,
        },
      ],
      "k": [
        "vim::Up",
        {
          "display_lines": true,
        },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && edit_prediction && !showing_completions",
    "bindings": {
      "ctrl-i": "editor::AcceptEditPrediction",
      "ctrl-j": "editor::AcceptNextWordEditPrediction",
    },
  },
  {
    "context": "GitPanel && (ChangesList || HistoryList) && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "AgentPanel && !Editor && !Terminal && !menu",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "AgentPanel > Editor && !menu",
    "bindings": {
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space g g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "AgentPanel > Editor && vim_mode == normal && !menu",
    "bindings": {
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
      "space a a": "agent::ToggleFocus",
      "space a o": "agent::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space c s": "outline_panel::ToggleFocus",
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "f13": "vim::ResizePaneLeft",
      "f14": "vim::ResizePaneRight",
      "f15": "vim::ResizePaneDown",
      "f16": "vim::ResizePaneUp",
      "f19": "vim::ClearOperators",
      "ctrl-w =": ["workspace::SendKeystrokes", "f19 2 f15 f20"],
      "f20 =": ["workspace::SendKeystrokes", "f19 2 f15 f20"],
      "ctrl-w +": ["workspace::SendKeystrokes", "f19 2 f16 f20"],
      "f20 +": ["workspace::SendKeystrokes", "f19 2 f16 f20"],
      "ctrl-w <": ["workspace::SendKeystrokes", "f19 4 f13 f20"],
      "f20 <": ["workspace::SendKeystrokes", "f19 4 f13 f20"],
      "ctrl-w >": ["workspace::SendKeystrokes", "f19 4 f14 f20"],
      "f20 >": ["workspace::SendKeystrokes", "f19 4 f14 f20"],
      "ctrl-w u": ["workspace::SendKeystrokes", "f19 f17 f20"],
      "ctrl-w shift-u": ["workspace::SendKeystrokes", "f19 f17 f20"],
      "f20 u": ["workspace::SendKeystrokes", "f19 f17 f20"],
      "f20 shift-u": ["workspace::SendKeystrokes", "f19 f17 f20"],
      "f20 escape": "vim::ClearOperators",
      "f20 ctrl-[": "vim::ClearOperators",
      "f20 q": "vim::ClearOperators",
      "f17": "vim::ResetPaneSizes",
    },
  },
  {
    "context": "(Dock) && !(vim_mode == insert)",
    "bindings": {
      "f13": [
        "workspace::DecreaseActiveDockSize",
        {
          "px": 40,
        },
      ],
      "f14": [
        "workspace::IncreaseActiveDockSize",
        {
          "px": 40,
        },
      ],
      "f17": "workspace::ResetActiveDockSize",
      "ctrl-w <": ["workspace::SendKeystrokes", "f13 f20"],
      "f20 <": ["workspace::SendKeystrokes", "f13 f20"],
      "ctrl-w >": ["workspace::SendKeystrokes", "f14 f20"],
      "f20 >": ["workspace::SendKeystrokes", "f14 f20"],
      "ctrl-w =": ["workspace::SendKeystrokes", "f13 f20"],
      "f20 =": ["workspace::SendKeystrokes", "f13 f20"],
      "ctrl-w +": ["workspace::SendKeystrokes", "f14 f20"],
      "f20 +": ["workspace::SendKeystrokes", "f14 f20"],
      "ctrl-w u": ["workspace::SendKeystrokes", "f17 f20"],
      "ctrl-w shift-u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 shift-u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 escape": ["workspace::SendKeystrokes", ""],
      "f20 ctrl-[": ["workspace::SendKeystrokes", ""],
      "f20 q": ["workspace::SendKeystrokes", ""],
    },
  },
  {
    "context": "(Dock > (Editor || Terminal || ProjectPanel || GitPanel || OutlinePanel || AgentPanel || DebugPanel || CollabPanel || NotificationPanel)) && !(vim_mode == insert)",
    "bindings": {
      "f13": [
        "workspace::DecreaseActiveDockSize",
        {
          "px": 40,
        },
      ],
      "f14": [
        "workspace::IncreaseActiveDockSize",
        {
          "px": 40,
        },
      ],
      "f17": "workspace::ResetActiveDockSize",
      "ctrl-w <": ["workspace::SendKeystrokes", "f13 f20"],
      "f20 <": ["workspace::SendKeystrokes", "f13 f20"],
      "ctrl-w >": ["workspace::SendKeystrokes", "f14 f20"],
      "f20 >": ["workspace::SendKeystrokes", "f14 f20"],
      "ctrl-w =": ["workspace::SendKeystrokes", "f13 f20"],
      "f20 =": ["workspace::SendKeystrokes", "f13 f20"],
      "ctrl-w +": ["workspace::SendKeystrokes", "f14 f20"],
      "f20 +": ["workspace::SendKeystrokes", "f14 f20"],
      "ctrl-w u": ["workspace::SendKeystrokes", "f17 f20"],
      "ctrl-w shift-u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 shift-u": ["workspace::SendKeystrokes", "f17 f20"],
      "f20 escape": ["workspace::SendKeystrokes", ""],
      "f20 ctrl-[": ["workspace::SendKeystrokes", ""],
      "f20 q": ["workspace::SendKeystrokes", ""],
    },
  },
  // Resize the center editor against a visible side Agent dock.
  {
    "context": "Workspace && (left_dock == agent_panel || right_dock == agent_panel) > Pane > Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "ctrl-w <": [
        "action::Sequence",
        [
          "vim::ClearOperators",
          "agent::ToggleFocus",
          [
            "workspace::IncreaseActiveDockSize",
            {
              "px": 40
            }
          ],
          "workspace::FocusCenterPane",
          [
            "workspace::SendKeystrokes",
            "f20"
          ]
        ]
      ],
      "f20 <": [
        "action::Sequence",
        [
          "vim::ClearOperators",
          "agent::ToggleFocus",
          [
            "workspace::IncreaseActiveDockSize",
            {
              "px": 40
            }
          ],
          "workspace::FocusCenterPane",
          [
            "workspace::SendKeystrokes",
            "f20"
          ]
        ]
      ],
      "ctrl-w >": [
        "action::Sequence",
        [
          "vim::ClearOperators",
          "agent::ToggleFocus",
          [
            "workspace::DecreaseActiveDockSize",
            {
              "px": 40
            }
          ],
          "workspace::FocusCenterPane",
          [
            "workspace::SendKeystrokes",
            "f20"
          ]
        ]
      ],
      "f20 >": [
        "action::Sequence",
        [
          "vim::ClearOperators",
          "agent::ToggleFocus",
          [
            "workspace::DecreaseActiveDockSize",
            {
              "px": 40
            }
          ],
          "workspace::FocusCenterPane",
          [
            "workspace::SendKeystrokes",
            "f20"
          ]
        ]
      ]
    }
  },
]
