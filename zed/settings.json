  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
        "completeUnimported": true,
        "usePlaceholders": true,
        "semanticTokens": true,
        "directoryFilters": [
          "-.git",
          "-.vscode",
          "-.idea",
          "-.vscode-test",
          "-node_modules"
        ],
        "analyses": {
          "nilness": true,
          "unusedparams": true,
          "unusedwrite": true,
          "useany": true,
          "ST1000": false,
          "ST1003": false
        },
        "codelenses": {
          "generate": true,
          "regenerate_cgo": true,
          "run_govulncheck": true,
          "test": true,
          "tidy": true,
          "upgrade_dependency": true,
          "vendor": true
        }
      }
    }
  },
  "code_lens": "on",
  "close_panel_on_toggle": true
}
